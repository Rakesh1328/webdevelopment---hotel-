
/* Basic Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #222;
    line-height: 1.6;
}

/* Header and Navigation */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    background: #12263f;
    color: white;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

nav a:hover {
    color: #c9a24a;
}

/* Hero Section */
.hero {
    text-align: center;
    padding: 120px 20px;
    color: white;
    background: #12263f;
}

.hero h1 {
    max-width: 700px;
    margin: 0 auto 20px;
    font-size: 2.4rem;
}

.btn {
    display: inline-block;
    padding: 12px 28px;
    background: #c9a24a;
    color: #12263f;
    text-decoration: none;
    font-weight: bold;
    border-radius: 4px;
}

/* Sections */
section {
    padding: 60px 40px;
    text-align: center;
}

section h2 {
    margin-bottom: 28px;
    color: #12263f;
}

.alt {
    background: #f2f4f7;
}

/* Cards - CSS Grid */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
}

.card {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 16px;
}

/* Room Image Placeholder */
.pic {
    height: 140px;
    background: #12263f;
    color: #c9a24a;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    margin-bottom: 12px;
}

/* Facilities */
ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
}

li {
    background: white;
    padding: 10px 20px;
    border-radius: 20px;
    border: 1px solid #ddd;
}

/* Booking Form */
form {
    max-width: 420px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

input, select, button {
    padding: 10px;
    font-size: 1rem;
    width: 100%;
}

label {
    text-align: left;
}

button {
    background: #12263f;
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 4px;
}

button:hover {
    background: #c9a24a;
    color: #12263f;
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    background: #12263f;
    color: white;
}

/* Responsive Mobile Layout */
@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 10px;
    }

    nav a {
        margin: 0 8px;
    }

    .hero h1 {
        font-size: 1.7rem;
    }

    section {
        padding: 40px 20px;
    }
}
