
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Royal Stay Hotel</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
    <h2>Royal Stay</h2>
    <nav>
      <a href="#rooms">Rooms</a>
      <a href="#facilities">Facilities</a>
      <a href="#reviews">Reviews</a>
      <a href="#booking">Book Now</a>
    </nav>
  </header>

  <section class="hero">
    <h1>A comfortable stay in the heart of the city</h1>
    <a class="btn" href="#booking">Book a room</a>
  </section>

  <!-- ROOM CATEGORIES -->
  <section id="rooms">
    <h2>Our Rooms</h2>
    <div class="cards">
      <div class="card">
        <div class="pic">Standard</div>
        <h3>Standard Room</h3>
        <p>1 double bed, AC, TV</p>
        <b>₹2,500 / night</b>
      </div>

      <div class="card">
        <div class="pic">Deluxe</div>
        <h3>Deluxe Room</h3>
        <p>King bed, balcony, breakfast</p>
        <b>₹4,000 / night</b>
      </div>

      <div class="card">
        <div class="pic">Suite</div>
        <h3>Family Suite</h3>
        <p>2 bedrooms, living area</p>
        <b>₹7,500 / night</b>
      </div>
    </div>
  </section>

  <section id="facilities" class="alt">
    <h2>Facilities</h2>
    <ul>
      <li>Free Wi-Fi</li>
      <li>Swimming pool</li>
      <li>Restaurant</li>
      <li>Parking</li>
      <li>Gym</li>
      <li>24/7 room service</li>
    </ul>
  </section>

  <section id="reviews">
    <h2>Guest Reviews</h2>
    <div class="cards">
      <div class="card">
        <p>"Clean rooms and friendly staff."</p>
        <b>Anil</b>
      </div>

      <div class="card">
        <p>"Great breakfast, great pool."</p>
        <b>Divya</b>
      </div>
    </div>
  </section>

  <!-- BOOKING FORM -->
  <section id="booking" class="alt">
    <h2>Book Your Room</h2>
    <form>
      <input type="text" placeholder="Your name" required>
      <input type="email" placeholder="Email" required>

      <label>
        Check-in
        <input type="date" required>
      </label>

      <label>
        Check-out
        <input type="date" required>
      </label>

      <select>
        <option>Standard Room</option>
        <option>Deluxe Room</option>
        <option>Family Suite</option>
      </select>

      <button type="submit">Book now</button>
    </form>
  </section>

  <footer>
    © 2026 Royal Stay Hotel | Contact: 98765 12345
  </footer>

</body>
</html>
